# ============================================
# Database Configuration
# ============================================
# Change these for production use
DATABASE_URL=postgresql://legal_user:dev_password_change_in_prod@localhost:5432/legal_rag
POSTGRES_USER=legal_user
POSTGRES_PASSWORD=dev_password_change_in_prod
POSTGRES_DB=legal_rag

# ============================================
# Qdrant Vector Database
# ============================================
# For Docker Compose: http://qdrant:6333
# For local development: http://localhost:6333
QDRANT_URL=http://localhost:6333

# ============================================
# Azure Blob Storage
# ============================================
# Replace with your actual Azure Storage connection string
# For local testing with Azurite: DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=YOUR_KEY;BlobEndpoint=http://localhost:10000/devstoreaccount1;
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=YOUR_AZURE_STORAGE_KEY_HERE;BlobEndpoint=http://localhost:10000/devstoreaccount1;

# ============================================
# OpenAI API
# ============================================
# Get from https://platform.openai.com/api-keys
# WARNING: Never commit actual API keys to version control
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# ============================================
# Celery & Redis
# ============================================
# For Docker Compose: redis://redis:6379/0 and redis://redis:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================
# Frontend
# ============================================
# For Docker Compose: http://backend:8000
# For local development: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================
# CORS
# ============================================
ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# Application
# ============================================
# Set to False in production
DEBUG=True
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://legal_user:secure_password@localhost:5432/legal_rag
POSTGRES_USER=legal_user
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=legal_rag

# ============================================
# Google AI (Gemini) Configuration - RAG LLM
# ============================================
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ============================================
# Cohere Configuration - Embeddings
# ============================================
# Get your API key from: https://dashboard.cohere.com/
COHERE_API_KEY=your-cohere-api-key-here

# ============================================
# OpenAI API Configuration (optional, no longer required)
# ============================================
# OPENAI_API_KEY=sk-xxx

# ============================================
# Qdrant Vector Database Configuration
# ============================================
QDRANT_URL=http://localhost:6333

# ============================================
# Azure Blob Storage Configuration
# ============================================
# For local development, use: UseDevelopmentStorage=true
# For production, use your actual connection string
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# ============================================
# JWT & Authentication Configuration
# ============================================
# Change this to a strong secret in production!
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# Redis / Celery Configuration
# ============================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================
# CORS Configuration
# ============================================
ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# Application Environment
# ============================================
# Set to False in production
DEBUG=True
ENVIRONMENT=development
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400

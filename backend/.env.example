# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://legal_user:secure_password@localhost:5432/legal_rag
POSTGRES_USER=legal_user
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=legal_rag

# ============================================
# OpenAI API Configuration
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# ============================================
# Qdrant Vector Database Configuration
# ============================================
QDRANT_URL=http://localhost:6333

# ============================================
# Azure Blob Storage Configuration
# ============================================
# For local development, use: UseDevelopmentStorage=true
# For production, use your actual connection string
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# ============================================
# JWT & Authentication Configuration
# ============================================
# Change this to a strong secret in production!
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# Application Environment
# ============================================
# Set to False in production
DEBUG=True
ENVIRONMENT=development
